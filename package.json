{
  "name": "buscador-empresas-br",
  "version": "1.0.0",
  "description": "Buscador de empresas brasileiras (Receita Federal / CNPJ) com dashboard futurista dourado e preto",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "import": "node scripts/import-receita.js",
